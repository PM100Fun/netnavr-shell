PORT=8787
VITE_NETNAVR_SHELL_WS=ws://127.0.0.1:8787/ws

# `npm run dev` generates and shares a fresh server/web session token automatically.
# When starting them separately, set both variables to the same fresh base64url token.
# NETNAVR_SHELL_SESSION_TOKEN=<fresh-base64url-token>
# VITE_NETNAVR_SHELL_TOKEN=<same-token>
